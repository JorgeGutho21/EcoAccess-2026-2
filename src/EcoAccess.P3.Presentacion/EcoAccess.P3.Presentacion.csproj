<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <UserSecretsId>ecoaccess-p3-framework</UserSecretsId>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Logo oficial en el ejecutable: lo usan la barra de tareas y el acceso directo «EcoAccess P3». -->
    <ApplicationIcon>..\..\assets\identidad\EcoAccess.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\EcoAccess.P3.Logica\EcoAccess.P3.Logica.csproj" />
    <ProjectReference Include="..\EcoAccess.P3.Entidades\EcoAccess.P3.Entidades.csproj" />
    <ProjectReference Include="..\EcoAccess.P3.Datos\EcoAccess.P3.Datos.csproj" />
    <EmbeddedResource Include="..\..\assets\identidad\Eco_perfil_Telegram.jpg" LogicalName="EcoAccess.Eco.jpg" Link="Recursos\Eco_perfil_Telegram.jpg" />
    <EmbeddedResource Include="..\..\assets\identidad\Logo_EcoAccess.png" LogicalName="EcoAccess.Logo.png" Link="Recursos\Logo_EcoAccess.png" />
    <EmbeddedResource Include="..\..\assets\identidad\QR_Caneca_piloto.png" LogicalName="EcoAccess.QrOficial.png" Link="Recursos\QR_Caneca_piloto.png" />
    <!-- Ilustraciones oficiales de ECO y de los 15 residuos del prototipo (scripts/documentacion/Preparar-ImagenesEco.ps1). -->
    <EmbeddedResource Include="..\..\assets\imagenes\**\*.png;..\..\assets\imagenes\**\*.jpg" LogicalName="EcoAccess.Img.%(RecursiveDir)%(Filename)%(Extension)" Link="Recursos\imagenes\%(RecursiveDir)%(Filename)%(Extension)" />
    <Reference Include="System.Configuration" />
    <PackageReference Include="FontAwesome.Sharp" Version="6.6.0" />
    <PackageReference Include="Krypton.Toolkit" Version="105.26.7.201" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WinForms" Version="2.0.5" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.9" />
  </ItemGroup>
</Project>
