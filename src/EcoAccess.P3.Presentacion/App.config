<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Proyecto de inicio de la solución: .NET Framework 4.8. -->
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <!--
    Parte pública de la conexión, leída con ConfigurationManager.ConnectionStrings["OracleP3"].
    NUNCA escribir aquí la contraseña: este archivo se versiona en GitHub. La cadena completa queda en los
    User Secrets «ecoaccess-p3-framework» (perfil de Windows) o en ECOACCESS_ConnectionStrings__OracleP3, y tiene
    prioridad sobre esta. Para otra base basta editar Data Source o User Id aquí, sin recompilar.
  -->
  <connectionStrings>
    <add name="OracleP3"
         connectionString="Data Source=localhost:1522/PRUEBAP3;User Id=ECOACCESS_P3_APP"
         providerName="Oracle.ManagedDataAccess.Client" />
  </connectionStrings>
</configuration>
