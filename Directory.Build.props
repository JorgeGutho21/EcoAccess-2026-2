<Project>
  <!-- Configuración común: toda la solución compila para .NET Framework 4.8 con C# 9 (Visual Studio 2019 16.8 o posterior). -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Product>EcoAccess P3</Product>
    <Company>Universidad Popular del Cesar</Company>
    <Authors>Jorge Gutierrez Thomas</Authors>
    <Description>EcoAccess P3, proyecto académico de la Universidad Popular del Cesar</Description>
    <Deterministic>true</Deterministic>
    
    <PlatformTarget>AnyCPU</PlatformTarget>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <PackageReference Include="System.Memory" Version="4.6.3" />
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.9" />
    <!-- Ensamblados de referencia de .NET Framework 4.8 desde NuGet: compila aunque el equipo no tenga el «targeting pack»
         (carga de trabajo de escritorio de Visual Studio). Solo se usa al compilar; no se copia a la aplicación. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'EcoAccess.P3.Compatibilidad'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)src\EcoAccess.P3.Compatibilidad\EcoAccess.P3.Compatibilidad.csproj" />
  </ItemGroup>
</Project>



