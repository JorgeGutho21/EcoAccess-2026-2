        "lineageTag": "bbcc5512-2206-4743-9a2b-a9d2622cf4ef",
        "measures": [
          {
            "name": "Depósitos registrados",
            "expression": "COUNTROWS ( Depositos )",
            "formatString": "#,0",
            "lineageTag": "6bb74f11-2dda-4188-9d24-b0bab1ab240d"
          },
          {
            "name": "Depósitos verificados",
            "expression": "CALCULATE ( COUNTROWS ( Depositos ), Depositos[ESTADO] = \"VERIFICADO\" )",
            "formatString": "#,0",
            "lineageTag": "e7b19de4-0b77-4f92-8f02-715cd3205663"
          },
          {
            "name": "Depósitos pendientes",
            "expression": "CALCULATE ( COUNTROWS ( Depositos ), Depositos[ESTADO] = \"PENDIENTE\" )",
            "formatString": "#,0",
            "lineageTag": "05ea49f7-e6e8-417b-b901-1873a480d4b1"
          },
          {
            "name": "Depósitos rechazados",
            "expression": "CALCULATE ( COUNTROWS ( Depositos ), Depositos[ESTADO] = \"RECHAZADO\" )",
            "formatString": "#,0",
            "lineageTag": "66086dc2-d1df-4325-a819-8fd6eb3d6e78"
          },
          {
            "name": "Unidades verificadas",
            "expression": "CALCULATE ( SUM ( Depositos[UNIDADES] ), Depositos[ESTADO] = \"VERIFICADO\" )",
            "formatString": "#,0",
            "lineageTag": "fb5b44ae-9f07-4d11-8924-f26a78134df5"
          },
          {
            "name": "Kg estimados (verificados)",
            "expression": "CALCULATE ( SUM ( Depositos[PESO_ESTIMADO_KG] ), Depositos[ESTADO] = \"VERIFICADO\" )",
            "formatString": "#,0.000",
            "lineageTag": "ba4b0b33-0acb-4532-b3a3-734d7dec79be"
          },
          {
            "name": "Kg medidos (verificados)",
            "expression": "CALCULATE ( SUM ( Depositos[PESO_MEDIDO_KG] ), Depositos[ESTADO] = \"VERIFICADO\" )",
            "formatString": "#,0.000",
            "lineageTag": "3be40f69-560f-48ac-bc57-7db375344658"
          },
          {
            "name": "Verificados con peso medido",
            "expression": "CALCULATE ( COUNTROWS ( Depositos ), Depositos[ESTADO] = \"VERIFICADO\", NOT ISBLANK ( Depositos[PESO_MEDIDO_KG] ) )",
            "formatString": "#,0",
            "lineageTag": "771841df-e1a1-49b5-b869-5f9dd5afe511"
          },
          {
            "name": "Ciudadanos con depósito verificado",
            "expression": "CALCULATE ( DISTINCTCOUNT ( Depositos[CIUDADANO] ), Depositos[ESTADO] = \"VERIFICADO\" )",
            "formatString": "#,0",
            "lineageTag": "50366eb1-9469-4294-b28f-1fe30f065a46"
          },
          {
            "name": "Rótulo datos",
            "expression": "\"Oracle Cloud (ECOACCESS_P3_APP) · las filas DATOS DE ENSAYO son pruebas, no depósitos reales\"",
            "lineageTag": "2f02da83-ff63-4913-8095-497490144569"
          }
        ],
        "partitions": [
          {
            "name": "Depositos",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    // Origen: vista VW_BI_DEPOSITOS de Oracle Cloud (ecoaccess_tp, ECOACCESS_P3_APP, migración V027) (o los CSV si OrigenDatos = \"CSV\")",
                "    Origen = if OrigenDatos = \"ORACLE\" then Oracle.Database(ServidorOracle, [HierarchicalNavigation = false]){[Schema = \"ECOACCESS_P3_APP\", Item = \"VW_BI_DEPOSITOS\"]}[Data] else Csv.Document(File.Contents(CarpetaDatos & \"\\vw_bi_depositos.csv\"), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
                "    Encabezados = if OrigenDatos = \"ORACLE\" then Origen else Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),",
                "    Tipos = Table.TransformColumnTypes(Encabezados, {{\"ID_DEPOSITO\", Int64.Type}, {\"CIUDADANO\", type text}, {\"DIA\", type datetime}, {\"FECHA_HORA\", type datetime}, {\"ESTACION\", type text}, {\"CANECA\", type text}, {\"MATERIAL\", type text}, {\"MATERIAL_NOMBRE\", type text}, {\"ESTADO\", type text}, {\"EVIDENCIA\", type text}, {\"UNIDADES\", Int64.Type}, {\"PESO_ESTIMADO_KG\", type number}, {\"PESO_MEDIDO_KG\", type number}, {\"CANAL\", type text}, {\"ORIGEN_DATO\", type text}}, \"en-US\"),",
                "    SoloFecha = Table.TransformColumnTypes(Tipos, {{\"DIA\", type date}})",
                "in",
                "    SoloFecha"
              ],
              "type": "m"
            }
          }
        ]
