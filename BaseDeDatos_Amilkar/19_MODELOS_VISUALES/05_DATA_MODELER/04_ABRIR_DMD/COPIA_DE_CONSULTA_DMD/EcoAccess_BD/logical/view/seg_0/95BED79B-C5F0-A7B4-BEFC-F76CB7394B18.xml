<EntityView class="oracle.dbtools.crest.model.design.logical.EntityView" directorySegmentName="seg_0" id="95BED79B-C5F0-A7B4-BEFC-F76CB7394B18" name="VW DEPOSITO DETALLE">
<createdBy>Usuario</createdBy>
<createdTime>2026-11-11 18:40:40 UTC</createdTime>
<generatorID>1C20F88E-D79C-700A-170F-A41EFE176A77</generatorID>
<ownerDesignName>EcoAccess_BD</ownerDesignName>
