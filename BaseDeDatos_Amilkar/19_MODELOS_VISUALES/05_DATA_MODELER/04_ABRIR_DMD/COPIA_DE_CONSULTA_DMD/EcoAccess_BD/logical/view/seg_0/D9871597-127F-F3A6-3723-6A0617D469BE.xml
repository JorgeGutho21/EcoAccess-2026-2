<EntityView class="oracle.dbtools.crest.model.design.logical.EntityView" directorySegmentName="seg_0" id="D9871597-127F-F3A6-3723-6A0617D469BE" name="VW BI AUDITORIA">
<createdBy>Usuario</createdBy>
<createdTime>2026-11-11 18:40:40 UTC</createdTime>
<generatorID>AE87B1FF-C357-39FB-4B54-80C718145C51</generatorID>
<ownerDesignName>EcoAccess_BD</ownerDesignName>
<engineerTo>
<item key="DBB87FFD-566F-EE69-5EE2-09C9FC6405FD" value="true"/>
</engineerTo>
<userDefined>true</userDefined>
<userDefinedSQL><![CDATA[SELECT a.id_auditoria,
       a.id_deposito,
       a.operacion,
       DECODE(a.estado_anterior, 0, 'PENDIENTE', 1, 'VERIFICADO', 2, 'RECHAZADO') AS estado_anterior,
       DECODE(a.estado_nuevo,    0, 'PENDIENTE', 1, 'VERIFICADO', 2, 'RECHAZADO') AS estado_nuevo,
       a.cantidad_anterior,
       a.cantidad_nueva,
       a.peso_medido_anterior_kg,
       a.peso_medido_nuevo_kg,
       CASE WHEN a.id_actor IS NULL THEN 'SIN ACTOR DE APLICACIÓN' ELSE 'U-' || LPAD(a.id_actor, 4, '0') END AS actor,
       a.motivo,
       CAST(FROM_TZ(a.fecha_utc, 'UTC') AT TIME ZONE 'America/Bogota' AS DATE) AS fecha_colombia
FROM   auditoria_deposito a]]></userDefinedSQL>
<validSQL>false</validSQL>
