<TableView class="oracle.dbtools.crest.model.design.relational.TableView" directorySegmentName="seg_0" id="AE87B1FF-C357-39FB-4B54-80C718145C51" name="VW_BI_AUDITORIA">
<sourceDDLFile>ecoaccess_ddl.sql</sourceDDLFile>
<createdBy>Usuario</createdBy>
